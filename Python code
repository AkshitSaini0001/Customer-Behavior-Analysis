import io
from psycopg2 import sql
from pandas.api.types import (
    is_integer_dtype,
    is_float_dtype,
    is_bool_dtype,
    is_datetime64_any_dtype
)

# Function to identify SQL data types
def get_sql_type(dtype):
    if is_bool_dtype(dtype):
        return "BOOLEAN"
    elif is_integer_dtype(dtype):
        return "BIGINT"
    elif is_float_dtype(dtype):
        return "DOUBLE PRECISION"
    elif is_datetime64_any_dtype(dtype):
        return "TIMESTAMP"
    else:
        return "TEXT"


try:
    cur = conn.cursor()

    # Create table columns
    columns = [
        sql.SQL("{} {}").format(
            sql.Identifier(col),
            sql.SQL(get_sql_type(df[col].dtype))
        )
        for col in df.columns
    ]

    # Recreate table
    cur.execute(
        "DROP TABLE IF EXISTS customer_shopping"
    )

    cur.execute(
        sql.SQL("CREATE TABLE customer_shopping ({})").format(
            sql.SQL(", ").join(columns)
        )
    )

    # Convert DataFrame into CSV buffer
    buffer = io.StringIO()
    df.to_csv(buffer, index=False, header=False, na_rep=r'\N')
    buffer.seek(0)

    # Upload data into PostgreSQL
    cur.copy_expert(
        r"COPY customer_shopping FROM STDIN WITH (FORMAT CSV, NULL '\N')",
        buffer
    )

    conn.commit()

    print("Data uploaded successfully!")

    # Check total records
    cur.execute("SELECT COUNT(*) FROM customer_shopping")
    print("Total Records:", cur.fetchone()[0])

    cur.close()
    conn.close()

except Exception as e:
    conn.rollback()
    print("Upload Error:", e)
    conn.close()
